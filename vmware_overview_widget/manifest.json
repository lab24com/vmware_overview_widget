{
	"manifest_version": 2.0,
	"id": "vmwareoverview",
	"type": "widget",
	"name": "VMware: Vista general",
	"namespace": "VmwareOverview",
	"version": "1.4.0",
	"author": "LAKA Soluciones Tecnológicas",
	"description": "Vista consolidada de máquinas virtuales, hipervisores ESXi y datastores descubiertos por la plantilla oficial VMware de Zabbix 7.0–8.0.",
	"url": "https://www.zabbix.com/integrations/vmware",
	"widget": {
		"js_class": "CWidgetVmwareOverview",
		"size": {
			"width": 72,
			"height": 12
		},
		"refresh_rate": 60,
		"in": {
			"groupids": {
				"type": "_hostgroupids"
			}
		},
		"out": [
			{
				"type": "_hostid"
			},
			{
				"type": "_hostids"
			}
		]
	},
	"actions": {
		"widget.vmwareoverview.view": {
			"class": "WidgetView"
		},
		"widget.vmwareoverview.disk.get": {
			"class": "DiskDetails",
			"layout": "layout.json"
		},
		"widget.vmwareoverview.vm.get": {
			"class": "VmDetails",
			"layout": "layout.json"
		},
		"widget.vmwareoverview.hv.get": {
			"class": "HvDetails",
			"layout": "layout.json"
		},
		"widget.vmwareoverview.datastore.get": {
			"class": "DatastoreDetails",
			"layout": "layout.json"
		},
		"widget.vmwareoverview.diagnostic.run": {
			"class": "Diagnostics",
			"layout": "layout.json"
		}
	},
	"assets": {
		"js": ["class.widget.js"],
		"css": ["widget.css"]
	}
}
